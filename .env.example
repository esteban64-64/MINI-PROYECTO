# Copia este archivo a .env y coloca tu clave real (nunca subas .env al repositorio)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
# openrouter/free puede enrutar a distintos modelos; para los experimentos fija un ID concreto
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=30
